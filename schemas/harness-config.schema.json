{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "my-harness/harness-config",
  "title": ".harness.json — 레포별 하네스 설정",
  "type": "object",
  "properties": {
    "verify": {
      "type": "object",
      "properties": {
        "commands": { "type": "object", "additionalProperties": { "type": "string" }, "description": "이름 → 셸 명령" },
        "onEdit": { "type": ["string", "null"], "description": "편집 직후 파일 하나에 돌릴 명령. {file} 자리에 경로" },
        "onEditExtensions": { "type": "array", "items": { "type": "string" } },
        "onStop": { "type": "array", "items": { "type": "string" }, "description": "완료 전 돌릴 commands 이름" },
        "onCommit": { "type": "array", "items": { "type": "string" }, "description": "커밋 전 돌릴 commands 이름" },
        "timeoutSec": { "type": "number", "exclusiveMinimum": 0, "default": 180, "description": "완료·커밋 검증 명령 하나의 시간 한도(초). 훅 전체 한도(커밋 270초, 완료 570초) 안에서 남은 시간이 더 짧으면 그만큼만" }
      }
    },
    "gates": {
      "type": "object",
      "properties": { "block": { "type": "boolean", "description": "false 면 막지 않고 안내만" } }
    },
    "guard": {
      "type": "object",
      "properties": {
        "protectedBranches": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" }, "description": "막을 명령 정규식" },
        "ask": { "type": "array", "items": { "type": "string" }, "description": "확인받을 명령 정규식" }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "base": { "type": "string" },
        "reviewers": { "type": "array", "items": { "enum": ["security", "quality", "backend", "frontend", "convention", "test"] } },
        "protect": { "type": "array", "items": { "type": "string" }, "description": "apply 스킬이 고치지 않을 파일 glob. 없으면 패키지 매니페스트·잠금 파일·마이그레이션·.harness.json" }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "rules": { "type": "array", "items": { "type": "string" }, "description": "rules/ 아래 주입할 폴더 (common 은 항상). 예: typescript, react, backend" },
        "maxLessons": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
