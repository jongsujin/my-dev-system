{
  "description": "my-harness (Codex): 규칙 주입, 위험 명령 차단, 커밋·완료 전 검증. 편집 직후 검사는 Codex 편집 도구 형식이 달라 제외.",
  "hooks": {
    "SessionStart": [
      { "matcher": ".*", "hooks": [{ "type": "command", "command": "HARNESS_PLATFORM=codex node \"$PLUGIN_ROOT/hooks/scripts/session-start.mjs\"", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "HARNESS_PLATFORM=codex node \"$PLUGIN_ROOT/hooks/scripts/guard.mjs\"", "timeout": 300 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "HARNESS_PLATFORM=codex node \"$PLUGIN_ROOT/hooks/scripts/verify-stop.mjs\"", "timeout": 600 }] }
    ]
  }
}
