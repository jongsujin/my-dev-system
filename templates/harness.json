{
  "verify": {
    "commands": {
      "lint": "npm run lint",
      "typecheck": "npm run typecheck",
      "test": "npm test"
    },
    "onEdit": "npx --no-install eslint {file}",
    "onStop": ["lint", "typecheck"],
    "onCommit": ["typecheck"],
    "timeoutSec": 180
  },
  "gates": { "block": true },
  "guard": {
    "protectedBranches": ["main"],
    "deny": [],
    "ask": []
  },
  "review": {
    "base": "main",
    "reviewers": ["security", "quality", "frontend", "convention", "test"]
  },
  "context": {
    "rules": ["typescript", "react"],
    "maxLessons": 6
  }
}
